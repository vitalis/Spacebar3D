    "Changes apply the next time you open or preview a model.": {
      "extractionState": "manual",
      "comment": "Shared app and Quick Look UI. Preserve format names, keyboard shortcuts and %@ placeholders.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes apply the next time you open or preview a model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改将在下次打开或预览模型时生效。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios se aplicarán la próxima vez que abras o previsualices un modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications s’appliquent à la prochaine ouverture ou au prochain aperçu d’un modèle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen gelten beim nächsten Öffnen oder Anzeigen einer Modellvorschau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更は次にモデルを開くかプレビューするときに適用されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações se aplicam na próxima vez que você abrir ou pré-visualizar um modelo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항은 다음에 모델을 열거나 미리 볼 때 적용됩니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche si applicano alla prossima apertura o anteprima di un modello."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения вступят в силу при следующем открытии или предпросмотре модели."
          }
        }
      },
      "generatesSymbol": false
    },
