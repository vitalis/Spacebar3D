    "Drag to turn the model. Drag with Shift, Option or Command held, or with the right button, to move it.": {
      "extractionState": "manual",
      "comment": "Shared app and Quick Look UI. Preserve format names, keyboard shortcuts and %@ placeholders.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to turn the model. Drag with Shift, Option or Command held, or with the right button, to move it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移可旋转模型。按住 Shift、Option 或 Command 拖移，或使用右键拖移，可移动模型。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para girar el modelo. Para moverlo, arrastra con Mayúsculas, Opción o Comando pulsado, o con el botón derecho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour tourner le modèle. Maintenez Maj, Option ou Commande, ou utilisez le bouton droit, pour le déplacer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe, um das Modell zu drehen. Halte beim Ziehen Umschalt, Option oder Befehl gedrückt oder nutze die rechte Maustaste, um es zu verschieben."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグでモデルを回転します。Shift、Option、Commandを押しながらドラッグするか、右ボタンでドラッグすると移動します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para girar o modelo. Para movê-lo, arraste com Shift, Option ou Command pressionado, ou com o botão direito."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 모델을 회전합니다. Shift, Option 또는 Command를 누른 채 드래그하거나 오른쪽 버튼으로 드래그하면 이동합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per ruotare il modello. Per spostarlo, trascina tenendo premuto Maiuscole, Opzione o Comando, oppure con il pulsante destro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивайте для поворота модели. Для перемещения удерживайте Shift, Option или Command либо используйте правую кнопку мыши."
          }
        }
      },
      "generatesSymbol": false
    },
