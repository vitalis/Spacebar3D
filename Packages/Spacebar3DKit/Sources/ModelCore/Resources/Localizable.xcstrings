    "Choose the folder that holds “%@” and its supporting files. Spacebar 3D needs read-only access.": {
      "extractionState": "manual",
      "comment": "Shared app and Quick Look UI. Preserve format names, keyboard shortcuts and %@ placeholders.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the folder that holds “%@” and its supporting files. Spacebar 3D needs read-only access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择包含“%@”及其支持文件的文件夹。Spacebar 3D 需要只读访问权限。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la carpeta que contiene «%@» y sus archivos auxiliares. Spacebar 3D necesita acceso de solo lectura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le dossier contenant « %@ » et ses fichiers associés. Spacebar 3D nécessite un accès en lecture seule."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle den Ordner mit „%@“ und den zugehörigen Dateien. Spacebar 3D benötigt Lesezugriff."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」と関連ファイルを含むフォルダを選択してください。Spacebar 3D は読み取り専用アクセスを必要とします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a pasta que contém “%@” e seus arquivos auxiliares. O Spacebar 3D precisa de acesso somente de leitura."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 및 관련 파일이 들어 있는 폴더를 선택하세요. Spacebar 3D에는 읽기 전용 접근 권한이 필요합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la cartella che contiene “%@” e i file associati. Spacebar 3D richiede accesso in sola lettura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите папку с файлом «%@» и связанными файлами. Spacebar 3D нужен доступ только для чтения."
          }
        }
      },
      "generatesSymbol": false
    },
