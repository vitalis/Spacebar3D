      },
      "generatesSymbol": false
    },
    "The arrow keys turn the model. In the app, Space plays or pauses animation. In Quick Look, Space closes the preview.": {
      "extractionState": "manual",
      "comment": "Shared app and Quick Look UI. Preserve format names, keyboard shortcuts and %@ placeholders.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The arrow keys turn the model. In the app, Space plays or pauses animation. In Quick Look, Space closes the preview."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方向键可旋转模型。在应用中，空格键播放或暂停动画。在“快速查看”中，空格键关闭预览。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las flechas giran el modelo. En la app, Espacio reproduce o pausa la animación. En Vista Rápida, Espacio cierra la vista previa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les flèches tournent le modèle. Dans l’app, Espace lance ou suspend l’animation. Dans Coup d’œil, Espace ferme l’aperçu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Pfeiltasten drehen das Modell. In der App startet oder pausiert die Leertaste die Animation. In Übersicht schließt sie die Vorschau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "矢印キーでモデルを回転します。アプリではスペースキーでアニメーションを再生・一時停止します。クイックルックではスペースキーでプレビューを閉じます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As setas giram o modelo. No app, Espaço reproduz ou pausa a animação. Na Visualização Rápida, Espaço fecha a prévia."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화살표 키로 모델을 회전합니다. 앱에서 스페이스 키는 애니메이션을 재생하거나 일시 정지합니다. 훑어보기에서는 미리보기를 닫습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le frecce ruotano il modello. Nell’app, Spazio avvia o sospende l’animazione. In Visualizzazione rapida, Spazio chiude l’anteprima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиши со стрелками поворачивают модель. В приложении пробел запускает или приостанавливает анимацию. В «Быстром просмотре» пробел закрывает окно."
          }
        }
      },
      "generatesSymbol": false
    },
    "The bar at the bottom chooses the view (Solid, Textured, Normal), the wireframe, the styles and the view settings.": {
      "extractionState": "manual",
      "comment": "Shared app and Quick Look UI. Preserve format names, keyboard shortcuts and %@ placeholders.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bar at the bottom chooses the view (Solid, Textured, Normal), the wireframe, the styles and the view settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "底部栏用于选择视图（实体、纹理、法线）、线框、样式和视图设置。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra inferior permite elegir la vista (Sólida, Texturizada, Normales), la malla de alambre, los estilos y los ajustes de vista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre du bas permet de choisir la vue (Solide, Texturée, Normales), le fil de fer, les styles et les réglages de la vue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der unteren Leiste lassen sich die Ansicht (Vollansicht, Texturiert, Normalen), das Drahtgitter, die Stile und die Ansichtseinstellungen auswählen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下部のバーで表示（ソリッド、テクスチャ、法線）、ワイヤーフレーム、スタイル、表示設定を選べます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra inferior permite escolher a vista (Sólida, Texturizada, Normais), o aramado, os estilos e os ajustes de visualização."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하단 막대에서 보기(솔리드, 텍스처, 법선), 와이어프레임, 스타일 및 보기 설정을 선택합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra in basso permette di scegliere la vista (Solida, Con texture, Normali), il reticolo, gli stili e le impostazioni della vista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На нижней панели можно выбрать вид (Сплошной, Текстуры, Нормали), включить каркас, выбрать стиль и открыть настройки вида."
          }
        }
      },
      "generatesSymbol": false
