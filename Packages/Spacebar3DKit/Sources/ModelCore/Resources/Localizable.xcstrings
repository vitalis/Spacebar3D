    "Option-Command-G shows the floor grid. Option-Command-R turns the model by itself.": {
      "extractionState": "manual",
      "comment": "Shared app and Quick Look UI. Preserve format names, keyboard shortcuts and %@ placeholders.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Option-Command-G shows the floor grid. Option-Command-R turns the model by itself."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Option-Command-G 显示地面网格。Option-Command-R 自动旋转模型。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opción-Comando-G muestra la cuadrícula del suelo. Opción-Comando-R gira el modelo automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Option-Commande-G affiche la grille au sol. Option-Commande-R fait tourner le modèle automatiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Option-Befehl-G zeigt das Bodenraster. Option-Befehl-R dreht das Modell automatisch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Option-Command-Gで床のグリッドを表示します。Option-Command-Rでモデルを自動回転します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Option-Command-G mostra a grade do chão. Option-Command-R gira o modelo automaticamente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Option-Command-G는 바닥 격자를 표시합니다. Option-Command-R은 모델을 자동으로 회전합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Opzione-Comando-G mostra la griglia del piano. Opzione-Comando-R ruota automaticamente il modello."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Option-Command-G показывает сетку пола. Option-Command-R включает автоматическое вращение модели."
          }
        }
      },
      "generatesSymbol": false
    },
